#!/usr/bin/env bash
# hippo — the one door into the memory engine (SRF-1): `hippo <verb> [args...]`.
#
# Claude Code puts this plugin's bin/ on the Bash tool's PATH (PLATFORM.md §1), so a bare
# `hippo <verb>` runs from any shell the agent opens; hooks and skills call it by its
# plugin-relative path. Every verb but `mcp` goes to memory.cli, which runs the verb's
# module exactly as `python -m memory.<module>` would. The verb table is
# plugin/memory/cli_verbs.py, and `hippo help` prints it.
#
# Interpreter: the plugin's own venv (${CLAUDE_PLUGIN_DATA}/venv) with PYTHONPATH at this
# script's plugin root, else bare python3 before bootstrap (recall still works BM25-only).
# The resolution is the ONE shared hippo_resolve_py() in hooks/_resolve_py.sh (OSP-6).
#
# The Bash tool gets no CLAUDE_PLUGIN_DATA. A marketplace install lives at
# ~/.claude/plugins/cache/<marketplace>/<plugin>/<version>/, and its data dir is
# ~/.claude/plugins/data/<plugin>-<marketplace> (characters other than letters, digits, _
# and - become -). When that dir holds a bootstrap sentinel, it is used. A --plugin-dir
# load lives outside the cache and stays on whatever the caller exported.
set -euo pipefail

# The plugin root (parent of bin/), found with builtins only: hooks call this script from a
# minimal PATH, so it may not lean on dirname/basename/tr.
case "${BASH_SOURCE[0]}" in
  */*) _bin_dir="${BASH_SOURCE[0]%/*}" ;;
  *) _bin_dir="." ;;
esac
SCRIPT_DIR="$(cd "$_bin_dir/.." && pwd)"

if [ -z "${CLAUDE_PLUGIN_DATA:-}" ]; then
  # Pure parameter expansion: no basename/dirname/tr forks on every call.
  _plugin="${SCRIPT_DIR%/*}"
  _market="${_plugin%/*}"
  _cache="${_market%/*}"
  _plugins="${_cache%/*}"
  if [ "${_cache##*/}" = "cache" ] && [ "${_plugins##*/}" = "plugins" ]; then
    _id="${_plugin##*/}-${_market##*/}"
    _data="$_plugins/data/${_id//[^A-Za-z0-9_-]/-}"
    if [ -f "$_data/.bootstrap-sentinel" ]; then
      export CLAUDE_PLUGIN_DATA="$_data"
    fi
  fi
fi

# shellcheck disable=SC1091  # dynamic path via SCRIPT_DIR; see hooks/_resolve_py.sh
. "${SCRIPT_DIR}/hooks/_resolve_py.sh"
CLAUDE_PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$SCRIPT_DIR}" hippo_resolve_py

cmd="${1:-}"

case "$cmd" in
  mcp)
    # INT-2: the stdio MCP server (mid-turn + subagent memory access). Long-lived — it owns
    # stdin/stdout for the JSON-RPC stream, so exec it directly and let it run until EOF.
    # OBS-2 counts it per tool call inside the server.
    shift
    exec "$PY" -m memory.mcp_server "$@"
    ;;
  *)
    exec "$PY" -m memory.cli "$@"
    ;;
esac
